# Set with: supabase secrets set --env-file supabase/.env
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
# Sign in with Apple
APPLE_SERVICES_ID=
APPLE_CLIENT_SECRET=

# ---- Web / OAuth ----
# Comma-separated allowed return URLs for mailbox OAuth (your web app origin + the iOS scheme)
APP_URLS=https://your-app.vercel.app,http://localhost:5173,aivoicetasks://mail-connected
# Gmail mailbox access (Google Cloud Console → OAuth client, type "Web application",
# redirect URI = https://<ref>.supabase.co/functions/v1/mail-oauth)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Microsoft 365 / Outlook mailbox access (Azure Portal → App registrations, redirect URI as above)
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
MS_OAUTH_TENANT=common
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts mailbox tokens/passwords at rest.
MAIL_ENCRYPTION_KEY=
# Shared secret for scheduled jobs (news-refresh, mail-sync). openssl rand -hex 24
CRON_SECRET=
