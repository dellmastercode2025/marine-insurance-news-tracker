# --- Telegram ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Comma-separated Telegram numeric user IDs with admin rights.
# The bot is PRIVATE: only these users (and users they /approve) can use it.
ADMIN_TELEGRAM_USER_IDS=11111111,22222222

# --- Database ---
# Production (managed PostgreSQL):
#   DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
# Local development (SQLite, zero setup):
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- AI provider ---
# Primary provider for the MVP is OpenAI. The AI layer is provider-agnostic;
# "anthropic" / "azure-openai" can be added later.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
# Optional stronger model for daily/weekly report composition (defaults to OPENAI_MODEL)
OPENAI_REPORT_MODEL=

# --- App ---
APP_ENV=production
LOG_LEVEL=INFO

# Operational timezone for scheduling and displayed timestamps
APP_TIMEZONE=Asia/Aqtau

# Token protecting the manual-trigger admin API endpoint (POST /admin/run-monitoring)
ADMIN_API_TOKEN=change-me-long-random-string

# Port for the health/admin HTTP server (most PaaS set PORT automatically)
PORT=8000
